/* Skeleton UI overrides for Moby Market theme */

/* Color palette customization */
:root {
  /* Moby Market primary colors */
  --color-primary-50: 240 249 255;
  --color-primary-100: 224 242 254;
  --color-primary-200: 186 230 253;
  --color-primary-300: 125 211 252;
  --color-primary-400: 56 189 248;
  --color-primary-500: 14 165 233;
  --color-primary-600: 2 132 199;
  --color-primary-700: 3 105 161;
  --color-primary-800: 7 89 133;
  --color-primary-900: 12 74 110;

  /* Whale gray scale */
  --color-surface-50: 248 250 252;
  --color-surface-100: 241 245 249;
  --color-surface-200: 226 232 240;
  --color-surface-300: 203 213 225;
  --color-surface-400: 148 163 184;
  --color-surface-500: 100 116 139;
  --color-surface-600: 71 85 105;
  --color-surface-700: 51 65 85;
  --color-surface-800: 30 41 59;
  --color-surface-900: 15 23 42;

  /* Success colors */
  --color-success-50: 240 253 244;
  --color-success-500: 34 197 94;
  --color-success-600: 22 163 74;
  --color-success-700: 21 128 61;

  /* Warning colors */
  --color-warning-50: 255 251 235;
  --color-warning-500: 245 158 11;
  --color-warning-600: 217 119 6;
  --color-warning-700: 180 83 9;

  /* Error colors */
  --color-error-50: 254 242 242;
  --color-error-500: 239 68 68;
  --color-error-600: 220 38 38;
  --color-error-700: 185 28 28;

  /* Typography */
  --font-heading: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-base: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', Monaco, Consolas, monospace;

  /* Border radius */
  --border-radius-container: 1rem;
  --border-radius-button: 0.75rem;
  --border-radius-card: 1rem;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  --shadow-glow: 0 0 20px rgba(14, 165, 233, 0.3);
}

/* Dark theme overrides */
:root.dark {
  --color-surface-50: 2 6 23;
  --color-surface-100: 15 23 42;
  --color-surface-200: 30 41 59;
  --color-surface-300: 51 65 85;
  --color-surface-400: 71 85 105;
  --color-surface-500: 100 116 139;
  --color-surface-600: 148 163 184;
  --color-surface-700: 203 213 225;
  --color-surface-800: 226 232 240;
  --color-surface-900: 241 245 249;
}

/* Component overrides */

/* Button variants */
.btn-variant-filled-primary {
  @apply bg-gradient-to-r from-moby-500 to-moby-600 text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200;
}

.btn-variant-filled-secondary {
  @apply bg-gradient-to-r from-whale-700 to-whale-800 text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200;
}

.btn-variant-ghost-primary {
  @apply text-moby-500 hover:bg-moby-500/10 border border-moby-500/20 hover:border-moby-500/40 transition-all duration-200;
}

.btn-variant-soft-primary {
  @apply bg-moby-500/10 text-moby-600 dark:text-moby-400 hover:bg-moby-500/20 transition-all duration-200;
}

/* Input variants */
.input-variant-form {
  @apply bg-white/5 border border-white/10 text-white placeholder-white/60 focus:border-moby-500 focus:ring-2 focus:ring-moby-500/20 backdrop-blur-sm transition-all duration-200;
}

.input-variant-form-dark {
  @apply bg-slate-800/50 border border-slate-700 text-white placeholder-slate-400 focus:border-moby-500 focus:ring-2 focus:ring-moby-500/20 transition-all duration-200;
}

/* Card variants */
.card-variant-glass {
  @apply bg-white/5 backdrop-blur-md border border-white/10 shadow-xl;
}

.card-variant-glass-dark {
  @apply bg-black/20 backdrop-blur-md border border-white/5 shadow-xl;
}

.card-variant-trading {
  @apply bg-gradient-to-br from-slate-900/50 to-blue-900/30 backdrop-blur-md border border-white/10 shadow-2xl hover:shadow-glow transition-all duration-300;
}

/* Table variants */
.table-variant-trading {
  @apply bg-white/5 backdrop-blur-md border border-white/10 rounded-xl overflow-hidden;
}

.table-variant-trading th {
  @apply bg-white/10 text-white font-semibold tracking-wider uppercase text-sm py-4 px-6;
}

.table-variant-trading td {
  @apply text-white/90 py-4 px-6 border-t border-white/5;
}

.table-variant-trading tbody tr:hover {
  @apply bg-white/5 transition-colors duration-200;
}

/* Modal variants */
.modal-variant-trading {
  @apply bg-slate-900/95 backdrop-blur-xl border border-white/10 shadow-2xl;
}

/* Tab variants */
.tab-variant-trading {
  @apply bg-white/5 border border-white/10 text-white/70 hover:text-white hover:bg-white/10 transition-all duration-200;
}

.tab-variant-trading[aria-selected="true"] {
  @apply bg-moby-500/20 border-moby-500/50 text-moby-400;
}

/* Progress bar variants */
.progress-variant-trading {
  @apply bg-white/10 rounded-full overflow-hidden;
}

.progress-variant-trading .progress-bar {
  @apply bg-gradient-to-r from-moby-500 to-moby-600 transition-all duration-500;
}

/* Alert variants */
.alert-variant-success {
  @apply bg-green-500/10 border border-green-500/20 text-green-400;
}

.alert-variant-warning {
  @apply bg-yellow-500/10 border border-yellow-500/20 text-yellow-400;
}

.alert-variant-error {
  @apply bg-red-500/10 border border-red-500/20 text-red-400;
}

.alert-variant-info {
  @apply bg-moby-500/10 border border-moby-500/20 text-moby-400;
}

/* Badge variants */
.badge-variant-whale {
  @apply bg-gradient-to-r from-moby-500 to-moby-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-glow;
}

.badge-variant-success {
  @apply bg-green-500/20 text-green-400 border border-green-500/30;
}

.badge-variant-warning {
  @apply bg-yellow-500/20 text-yellow-400 border border-yellow-500/30;
}

.badge-variant-error {
  @apply bg-red-500/20 text-red-400 border border-red-500/30;
}

/* Skeleton loading variants */
.skeleton-variant-trading {
  @apply bg-white/10 animate-pulse rounded;
}

/* Dropdown variants */
.dropdown-variant-trading {
  @apply bg-slate-900/95 backdrop-blur-xl border border-white/10 shadow-2xl rounded-xl overflow-hidden;
}

.dropdown-variant-trading .dropdown-item {
  @apply px-4 py-3 text-white/90 hover:bg-white/10 hover:text-white transition-all duration-200 cursor-pointer;
}

/* Tooltip variants */
.tooltip-variant-trading {
  @apply bg-slate-900/95 backdrop-blur-xl border border-white/20 text-white text-sm px-3 py-2 rounded-lg shadow-xl;
}

/* Switch variants */
.switch-variant-trading {
  @apply bg-white/20 border border-white/30;
}

.switch-variant-trading[aria-checked="true"] {
  @apply bg-moby-500 border-moby-500;
}

/* Radio group variants */
.radio-variant-trading {
  @apply bg-white/5 border border-white/20 text-white hover:bg-white/10 transition-all duration-200;
}

.radio-variant-trading[aria-checked="true"] {
  @apply bg-moby-500/20 border-moby-500 text-moby-400;
}

/* Accordion variants */
.accordion-variant-trading {
  @apply bg-white/5 border border-white/10 rounded-xl overflow-hidden;
}

.accordion-variant-trading .accordion-header {
  @apply bg-white/5 text-white font-semibold px-6 py-4 hover:bg-white/10 transition-all duration-200;
}

.accordion-variant-trading .accordion-content {
  @apply px-6 py-4 text-white/90 border-t border-white/10;
}

/* Stepper variants */
.stepper-variant-trading .step {
  @apply bg-white/10 border border-white/20 text-white/70;
}

.stepper-variant-trading .step.completed {
  @apply bg-moby-500 border-moby-500 text-white;
}

.stepper-variant-trading .step.active {
  @apply bg-moby-500/20 border-moby-500 text-moby-400 ring-2 ring-moby-500/50;
}

/* Custom animations */
@keyframes shimmer {
  0% {
    background-position: -200px 0;
  }
  100% {
    background-position: calc(200px + 100%) 0;
  }
}

.shimmer {
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  background-size: 200px 100%;
  animation: shimmer 2s infinite;
}

/* Responsive typography */
@media (max-width: 640px) {
  .text-display {
    @apply text-3xl;
  }

  .text-headline {
    @apply text-xl;
  }

  .text-title {
    @apply text-lg;
  }
}