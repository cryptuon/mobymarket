# Moby Market Frontend Environment Configuration
# Copy this file to .env.local and configure your values

# ==============================================
# API Configuration
# ==============================================
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_BASE_URL=ws://localhost:3000

# ==============================================
# Application Configuration
# ==============================================
VITE_APP_NAME=Moby Market
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_APP_DESCRIPTION=Whale Trading Intelligence Platform

# ==============================================
# Feature Flags
# ==============================================
# Enable/disable demo mode with sample data
VITE_ENABLE_DEMO_MODE=true

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable error reporting to external services
VITE_ENABLE_ERROR_REPORTING=false

# Enable debug mode for additional logging
VITE_DEBUG_MODE=true

# Enable maintenance mode
VITE_MAINTENANCE_MODE=false

# ==============================================
# External Services
# ==============================================
# WalletConnect Project ID (required for wallet connections)
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# CoinGecko API Key (for market data)
VITE_COINGECKO_API_KEY=your_coingecko_api_key

# Alchemy API Key (for blockchain data)
VITE_ALCHEMY_API_KEY=your_alchemy_api_key

# Infura Project ID (for blockchain access)
VITE_INFURA_PROJECT_ID=your_infura_project_id

# Moralis API Key (for NFT and DeFi data)
VITE_MORALIS_API_KEY=your_moralis_api_key

# ==============================================
# Authentication
# ==============================================
# JWT token expiration time
VITE_JWT_EXPIRES_IN=24h

# Refresh token expiration time
VITE_REFRESH_TOKEN_EXPIRES_IN=7d

# OAuth providers (optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GITHUB_CLIENT_ID=your_github_client_id

# ==============================================
# Development Configuration
# ==============================================
# Use mock API instead of real backend
VITE_MOCK_API=true

# Enable hot module replacement
VITE_HMR=true

# Enable source maps in development
VITE_SOURCE_MAPS=true

# Enable TypeScript strict mode
VITE_TS_STRICT=true

# ==============================================
# Analytics & Monitoring
# ==============================================
# Google Analytics ID
VITE_GA_ID=GA-XXXXXXXXX

# Sentry DSN for error tracking
VITE_SENTRY_DSN=your_sentry_dsn

# LogRocket Project ID
VITE_LOGROCKET_ID=your_logrocket_id

# Hotjar Site ID
VITE_HOTJAR_ID=your_hotjar_id

# ==============================================
# Security
# ==============================================
# Content Security Policy settings
VITE_CSP_ENABLED=true

# Rate limiting for API calls
VITE_RATE_LIMIT_ENABLED=true
VITE_RATE_LIMIT_MAX=100
VITE_RATE_LIMIT_WINDOW=60000

# ==============================================
# Performance
# ==============================================
# Enable service worker for caching
VITE_SW_ENABLED=true

# Enable code splitting
VITE_CODE_SPLITTING=true

# Bundle size limit in KB
VITE_BUNDLE_SIZE_LIMIT=500

# ==============================================
# Blockchain Networks
# ==============================================
# Default network for wallet connections
VITE_DEFAULT_NETWORK=ethereum

# Supported networks (comma-separated)
VITE_SUPPORTED_NETWORKS=ethereum,polygon,arbitrum,optimism,base

# Network RPC URLs
VITE_ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your_key
VITE_POLYGON_RPC_URL=https://polygon-mainnet.alchemyapi.io/v2/your_key
VITE_ARBITRUM_RPC_URL=https://arb-mainnet.alchemyapi.io/v2/your_key
VITE_OPTIMISM_RPC_URL=https://opt-mainnet.alchemyapi.io/v2/your_key
VITE_BASE_RPC_URL=https://base-mainnet.alchemyapi.io/v2/your_key

# ==============================================
# Trading Configuration
# ==============================================
# Default trading pair
VITE_DEFAULT_TRADING_PAIR=ETH/USDT

# Maximum position size (in USD)
VITE_MAX_POSITION_SIZE=100000

# Default slippage tolerance (%)
VITE_DEFAULT_SLIPPAGE=0.5

# Minimum order size (in USD)
VITE_MIN_ORDER_SIZE=10

# ==============================================
# Whale Tracking
# ==============================================
# Minimum transaction value to be considered a whale transaction (in USD)
VITE_WHALE_THRESHOLD=100000

# Maximum whale transactions to display
VITE_MAX_WHALE_TRANSACTIONS=50

# Whale alert notification threshold (in USD)
VITE_WHALE_ALERT_THRESHOLD=1000000

# ==============================================
# UI Configuration
# ==============================================
# Default theme (light/dark/system)
VITE_DEFAULT_THEME=dark

# Default language
VITE_DEFAULT_LANGUAGE=en

# Default currency for display
VITE_DEFAULT_CURRENCY=USD

# Maximum items per page for pagination
VITE_DEFAULT_PAGE_SIZE=20

# Chart refresh interval (in milliseconds)
VITE_CHART_REFRESH_INTERVAL=5000

# ==============================================
# PWA Configuration
# ==============================================
# Enable Progressive Web App features
VITE_PWA_ENABLED=true

# PWA offline support
VITE_PWA_OFFLINE=true

# PWA update strategy (prompt/auto)
VITE_PWA_UPDATE_STRATEGY=prompt

# ==============================================
# Development Only
# ==============================================
# Show development tools in production (NEVER set to true in production)
VITE_DEV_TOOLS=false

# Mock WebSocket connections
VITE_MOCK_WEBSOCKET=true

# Delay for mock API responses (in milliseconds)
VITE_MOCK_DELAY=500

# Enable Redux DevTools
VITE_REDUX_DEVTOOLS=true

# ==============================================
# Environment Specific Overrides
# ==============================================
# The following variables will be overridden by environment-specific files:
# .env.development - Development environment
# .env.staging - Staging environment
# .env.production - Production environment
# .env.local - Local development (not committed to git)

# ==============================================
# Notes
# ==============================================
# 1. All VITE_ prefixed variables are exposed to the frontend
# 2. Never include sensitive data in frontend environment variables
# 3. Use .env.local for local development overrides
# 4. Restart the development server after changing environment variables
# 5. See docs/SETUP.md for detailed configuration instructions